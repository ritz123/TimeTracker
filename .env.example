# Google OAuth credentials for Google Drive sync.
# See electron/google-credentials.js for setup instructions.
#
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "Google Drive API"
# 3. OAuth consent screen → External → add test user emails
# 4. Credentials → Create OAuth client ID → type "Desktop app"
# 5. Copy values below

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
