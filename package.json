{
  "name": "weekly-tracker",
  "version": "1.0.0",
  "description": "Desktop app for tracking weekly work items and achievements",
  "main": "electron/main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "launch": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "html2pdf.js": "^0.14.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  }
}
