{\n  "name": "time-tracker",\n  "version": "1.3.0",\n  "description": "Time Tracker — Desktop app for tracking work items and achievements",\n  "license": "GPL-2.0-only",\n  "author": "Biplab Sarkar <biplab@example.com>",\n  "main": "electron/main.js",\n  "scripts": {\n    "start": "vite build && electron .",\n    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",\n    "build": "vite build",\n    "launch": "electron .",\n    "dist:linux": "vite build && electron-builder --linux",\n    "dist:win": "vite build && electron-builder --win",\n    "dist:all": "vite build && electron-builder --linux --win",\n    "cap:build": "vite build && npx cap sync android"\n  },\n  "build": {\n    "appId": "com.biplabsarkar.timetracker",\n    "productName": "Time Tracker",\n    "directories": {\n      "output": "release"\n    },\n    "files": [\n      "dist/**/*",\n      "electron/**/*",\n      "node_modules/**/*",\n      "package.json"\n    ],\n    "linux": {\n      "target": [\n        "AppImage",\n        "deb"\n      ],\n      "category": "Office",\n      "icon": "build/icons"\n    },\n    "win": {\n      "target": [\n        "nsis",\n        "portable"\n      ],\n      "icon": "build/icons/icon.ico"\n    },\n    "nsis": {\n      "oneClick": false,\n      "allowToChangeInstallationDirectory": true,\n      "installerIcon": "build/icons/icon.ico"\n    }\n  },\n  "dependencies": {\n    "@capacitor/android": "^8.3.1",\n    "date-fns": "^4.1.0",\n    "dotenv": "^17.4.2",\n    "googleapis": "^171.4.0",\n    "html2pdf.js": "^0.14.0",\n    "uuid": "^11.1.0"\n  },\n  "devDependencies": {\n    "@capacitor/cli": "^8.3.1",\n    "@capacitor/core": "^8.3.1",\n    "@vitejs/plugin-react": "^4.4.1",\n    "autoprefixer": "^10.4.21",\n    "concurrently": "^9.1.2",\n    "electron": "^35.1.2",\n    "electron-builder": "^25.1.8",\n    "postcss": "^8.5.3",\n    "react": "^19.1.0",\n    "react-dom": "^19.1.0",\n    "tailwindcss": "^3.4.17",\n    "vite": "^6.3.2",\n    "wait-on": "^8.0.3"\n  }\n}