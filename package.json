{
  "name": "time-tracker",
  "version": "1.2.0",
  "description": "Time Tracker — Desktop app for tracking work items and achievements",
  "license": "GPL-2.0-only",
  "author": "Biplab Sarkar",
  "main": "electron/main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "launch": "electron .",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:win": "vite build && electron-builder --win",
    "dist:all": "vite build && electron-builder --linux --win",
    "cap:build": "vite build && npx cap sync android"
  },
  "build": {
    "appId": "com.biplabsarkar.timetracker",
    "productName": "Time Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icons/icon.ico"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "html2pdf.js": "^0.14.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  }
}
